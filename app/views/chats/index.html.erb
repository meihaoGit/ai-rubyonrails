<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8 min-h-screen bg-white">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-semibold text-gray-900 tracking-tight">Chats</h1>
    <%= button_to chats_path, method: :post, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-full text-white bg-blue-600 hover:bg-blue-700 transition ease-in-out duration-150 shadow-sm" do %>
      <%= lucide_icon("plus", class: "w-4 h-4 mr-1.5") %>
      New Chat
    <% end %>
  </div>

  <div class="bg-white border-t border-gray-100">
    <ul role="list" class="divide-y divide-gray-100">
      <% @chats.each do |chat| %>
        <li class="relative flex justify-between gap-x-6 px-2 py-5 hover:bg-gray-50 transition-colors duration-150 group rounded-xl">
          <div class="flex gap-x-4 items-center">
            <div class="h-10 w-10 flex-none rounded-full bg-gray-50 flex items-center justify-center text-gray-400 group-hover:text-blue-500 group-hover:bg-blue-50 transition-colors">
              <%= lucide_icon("message-square", class: "w-5 h-5") %>
            </div>
            <div class="min-w-0 flex-auto">
              <p class="text-[15px] font-medium leading-6 text-gray-900">
                <%= link_to chat_path(chat) do %>
                  <span class="absolute inset-0"></span>
                  <%= chat.title.presence || "New Conversation" %>
                <% end %>
              </p>
              <p class="mt-1 flex text-xs leading-5 text-gray-500">
                <%= time_ago_in_words(chat.updated_at) %> ago
              </p>
            </div>
          </div>
          <div class="flex items-center gap-x-4">
            <%= lucide_icon("chevron-right", class: "h-5 w-5 flex-none text-gray-300 group-hover:text-gray-400 transition-colors") %>
          </div>
        </li>
      <% end %>
      <% if @chats.empty? %>
        <li class="py-12 text-center">
          <%= lucide_icon("messages-square", class: "mx-auto h-12 w-12 text-gray-300 mb-3") %>
          <p class="text-sm text-gray-500">No chat history found. Start a new conversation.</p>
        </li>
      <% end %>
    </ul>
  </div>
</div>
