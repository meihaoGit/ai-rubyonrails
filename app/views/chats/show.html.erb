<div class="max-w-3xl mx-auto flex flex-col h-screen bg-white" data-controller="chat">
  <!-- Header -->
  <header class="bg-white/80 backdrop-blur-md sticky top-0 z-10 border-b border-gray-100 px-4 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to chats_path, class: "p-2 -ml-2 text-gray-400 hover:text-gray-900 rounded-full hover:bg-gray-50 transition" do %>
        <%= lucide_icon("chevron-left", class: "w-6 h-6") %>
      <% end %>
      <h1 class="text-[17px] font-semibold text-gray-900 tracking-tight truncate max-w-[200px] sm:max-w-xs"><%= @chat.title %></h1>
    </div>
  </header>

  <!-- Messages Area -->
  <div class="flex-1 overflow-y-auto px-4 py-6 space-y-6" id="messages_container" data-chat-target="messages">
    <%= turbo_frame_tag "messages" do %>
      <% @messages.each do |message| %>
        <%= render(MessageComponent.new(message: message)) %>
      <% end %>
    <% end %>
  </div>

  <!-- Input Area -->
  <div class="bg-white px-4 py-4 shrink-0 mb-safe border-t border-gray-100">
    <!-- TurboStreamレスポンスを返す想定のアクションへSubmit -->
    <%= form_with(model: [@chat, Message.new], id: "new_message_form", data: { action: "turbo:submit-end->chat#clearInput" }) do |f| %>
      <div class="relative flex items-end shadow-sm ring-1 ring-inset ring-gray-200 focus-within:ring-2 focus-within:ring-inset focus-within:ring-blue-600 rounded-2xl bg-[#F2F2F7]">
        <%= f.text_area :content, 
            rows: 1, 
            placeholder: "Message AI...", 
            class: "block w-full border-0 bg-transparent py-3.5 pl-4 pr-12 text-gray-900 placeholder:text-gray-500 focus:ring-0 sm:text-[15px] sm:leading-6 resize-none max-h-32", 
            data: { chat_target: "input", action: "keydown.enter->chat#submitForm input->chat#resize" } %>
        
        <button type="submit" class="absolute right-2 bottom-2 p-1.5 text-blue-600 hover:text-blue-700 bg-blue-100 hover:bg-blue-200 rounded-full transition-colors flex items-center justify-center">
          <%= lucide_icon("arrow-up", class: "w-5 h-5 stroke-[2.5]") %>
        </button>
      </div>
    <% end %>
  </div>
</div>
